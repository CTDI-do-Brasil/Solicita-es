# Configurações do Banco de Dados PostgreSQL (nexus)
# Link Adminer CTDI: https://dbadmin.ctdibrasil.com.br/?pgsql=srv-captain--db-postgres&username=postgres&db=nexus&ns=public

# Opção 1: DATABASE_URL completa
DATABASE_URL="postgresql://postgres:SUA_SENHA_AQUI@srv-captain--db-postgres:5432/nexus"

# Opção 2: Parâmetros individuais (usados caso DATABASE_URL não seja preenchida)
PGHOST="srv-captain--db-postgres"
PGPORT=5432
PGUSER="postgres"
PGPASSWORD="SUA_SENHA_AQUI"
PGDATABASE="nexus"
PGSSL=false

# Porta da API Backend Express
PORT=3001

# Chave Gemini AI (se aplicável)
GEMINI_API_KEY=""
