# Configurações do Banco de Dados PostgreSQL (nexus)
# Link Adminer CTDI: https://dbadmin.ctdibrasil.com.br/?pgsql=srv-captain--db-postgres&username=postgres&db=nexus&ns=public

# Opção 1: DATABASE_URL completa
DATABASE_URL="postgresql://postgres:SUA_SENHA_AQUI@srv-captain--db-postgres:5432/nexus"

# Opção 2: Parâmetros individuais (usados caso DATABASE_URL não seja preenchida)
PGHOST="srv-captain--db-postgres"
PGPORT=5432
PGUSER="postgres"
PGPASSWORD="SUA_SENHA_AQUI"
PGDATABASE="nexus"
PGSSL=false

# Porta da API Backend Express
PORT=3001

# URL pública da aplicação (usada nos links enviados dentro dos e-mails)
APP_URL="https://nexus.ctdibrasil.com.br"

# ==============================================================================
# CONFIGURAÇÕES DO DISPARO DE E-MAIL AUTOMÁTICO (SMTP / UOL HOST OU CAPROVER)
# ==============================================================================
# Host/Endereço do servidor SMTP (UOL Host: smtps.uhserver.com)
SMTP_HOST="smtps.uhserver.com"

# Porta SMTP (465 para SSL/TLS direto, 587 para STARTTLS, ou 25 para rede interna)
SMTP_PORT=465

# Define se usa SSL direto (true para porta 465, false para porta 587/25)
SMTP_SECURE=true

# Usuário/Login de autenticação do e-mail
SMTP_USER="nexus@ctdisystem.com.br"

# Senha da conta de e-mail / credencial SMTP
SMTP_PASS="SUA_SENHA_AQUI"

# Remetente de exibição (deve pertencer ao domínio autenticado)
SMTP_FROM="Nexus CTDI <nexus@ctdisystem.com.br>"

# E-mail geral de Compras (usado como fallback se não houver usuários cadastrados com perfil 'compras')
EMAIL_COMPRAS="compras@ctdibrasil.com.br"

# MODO DE TESTE LOCAL / HOMOLOGAÇÃO:
# Se preenchido, TODOS os e-mails disparados serão redirecionados exclusivamente para este endereço.
# Deixe vazio ("") para enviar aos destinatários reais em produção.
EMAIL_OVERRIDE_TO="apongeluppi@ctdi.com"

# E-mails de fallback dos Aprovadores da Diretoria (usados caso não estejam cadastrados na tabela users)
EMAIL_APROVADOR_FERNANDO="fernando.silva@ctdibrasil.com.br"
EMAIL_APROVADOR_EDUARDO="eduardo.costa@ctdibrasil.com.br"
EMAIL_APROVADOR_LUIZ="luiz.martins@ctdibrasil.com.br"

# Chave Gemini AI (se aplicável)
GEMINI_API_KEY=""
